{
  "name": "jbrowse-plugin-ucsc",
  "version": "1.0.4",
  "description": "JBrowse 2 UCSC API plugin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cmdcolin/jbrowse-plugin-ucsc-api.git"
  },
  "jbrowse-plugin": {
    "name": "UCSC"
  },
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "scripts": {
    "clean": "rimraf dist",
    "format": "oxfmt",
    "prebuild": "pnpm clean",
    "start": "node esbuild.mjs --watch",
    "build": "tsc -p tsconfig.build.json && NODE_ENV=production node esbuild.mjs",
    "build:bundle": "NODE_ENV=production node esbuild.mjs",
    "postbuild": "cp distconfig.json dist/config.json",
    "lint": "OXLINT_TSGOLINT_PATH=node_modules/.bin/tsgolint oxlint --type-aware --tsconfig tsconfig.json --deny-warnings",
    "test": "vitest run",
    "prepack": "pnpm build",
    "preversion": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm host-compat",
    "postversion": "git push --follow-tags",
    "typecheck": "tsrs --noEmit -p tsconfig.json",
    "format:check": "oxfmt --check",
    "host-compat": "node scripts/host-compat-probe.mjs --bundle dist/jbrowse-plugin-ucsc.umd.production.min.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "author": "Colin Diesh",
  "license": "MIT",
  "keywords": [
    "jbrowse",
    "jbrowse2"
  ],
  "peerDependencies": {
    "@jbrowse/core": ">=2.0.0"
  },
  "devDependencies": {
    "@fal-works/esbuild-plugin-global-externals": "^2.1.2",
    "@jbrowse/core": "5.0.0-beta.20",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "esbuild": "^0.28.0",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "oxlint-tsgolint": "^7.0.2008",
    "pretty-bytes": "^7.1.0",
    "puppeteer-core": "^25.18.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "rimraf": "^6.1.3",
    "rxjs": "^7.8.2",
    "tsrs": "7.1.0-beta.tsrs4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
